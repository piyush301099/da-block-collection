  {
    "id": "stress-import",
    "fields": [
      {
        "component": "select",
        "name": "classes_batchSize",
        "label": "Batch Size",
        "description": "Controls how many stress-import panels are loaded per batch before the rest are deferred. Authored as a block-name-row modifier; the JS extracts the numeric value from the class name via regex rather than treating it as a simple on/off toggle.",
        "options": [
          {
            "name": "6 per batch",
            "value": "batch-size-6"
          },
          {
            "name": "12 per batch",
            "value": "batch-size-12"
          },
          {
            "name": "24 per batch",
            "value": "batch-size-24"
          },
          {
            "name": "48 per batch",
            "value": "batch-size-48"
          }
        ]
      },
      {
        "component": "select",
        "name": "classes_headingScale",
        "label": "Heading Font Size",
        "description": "Sets the CSS custom property driving each panel's heading font size. Like Batch Size, this is a value-carrying modifier class (e.g. heading-scale-32px), not a boolean flag.",
        "options": [
          {
            "name": "20px",
            "value": "heading-scale-20px"
          },
          {
            "name": "24px",
            "value": "heading-scale-24px"
          },
          {
            "name": "28px",
            "value": "heading-scale-28px"
          },
          {
            "name": "32px",
            "value": "heading-scale-32px"
          },
          {
            "name": "40px",
            "value": "heading-scale-40px"
          }
        ]
      },
      {
        "component": "select",
        "name": "classes_panelOneTarget",
        "label": "Panel One — Link Target",
        "description": "Whether links inside the first authored panel row open in the same browser tab or a new one. Part of a flat, positionally enumerated set of per-panel fields (one through six) rather than a repeating container/child-item structure.",
        "options": [
          {
            "name": "Same tab",
            "value": "panel-one-target-sametab"
          },
          {
            "name": "New tab",
            "value": "panel-one-target-newtab"
          }
        ]
      },
      {
        "component": "select",
        "name": "classes_panelOneConfirm",
        "label": "Panel One — Confirm Before Leaving",
        "description": "Whether navigating away from Panel One prompts a confirmation dialog first.",
        "options": [
          {
            "name": "No confirmation",
            "value": "panel-one-confirm-no"
          },
          {
            "name": "Confirm before leaving",
            "value": "panel-one-confirm-yes"
          }
        ]
      },
      {
        "component": "select",
        "name": "classes_panelOneIcon",
        "label": "Panel One — Icon Style",
        "description": "The shape treatment applied to any icon rendered inside Panel One.",
