          {
            "name": "Circle",
            "value": "panel-one-icon-circle"
          },
          {
            "name": "Square",
            "value": "panel-one-icon-square"
          },
          {
            "name": "No icon frame",
            "value": "panel-one-icon-none"
          }
        ]
      },
