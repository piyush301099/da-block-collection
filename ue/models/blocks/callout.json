{
  "definitions": [
    {
      "title": "Callout",
      "id": "callout",
      "model": "callout",
      "plugins": {
        "da": {
          "name": "callout",
          "rows": 2,
          "columns": 1,
          "fields": [
            { "name": "heading", "selector": "div:nth-child(1)>div" },
            { "name": "description", "selector": "div:nth-child(2)>div" },
            { "name": "classes", "selector": ":scope" }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "callout",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "heading",
          "label": "Heading",
          "required": true
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "description",
          "label": "Description"
        },
        {
          "component": "multiselect",
          "name": "classes",
          "label": "Style",
          "description": "Select a theme and optionally an icon for this callout",
          "value": ["theme-light"],
          "options": [
            {
              "name": "Theme",
              "children": [
                { "name": "Light", "value": "theme-light" },
                { "name": "Dark", "value": "theme-dark" },
                { "name": "Brand", "value": "theme-brand" }
              ]
            },
            {
              "name": "Icon",
              "children": [
                { "name": "Info", "value": "icon-info" },
                { "name": "Warning", "value": "icon-warning" },
                { "name": "Success", "value": "icon-success" }
              ]
            }
          ]
        }
      ]
    }
  ],
  "filters": []
}
